<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryLight"
    tools:context=".PagoFacilActivity">

    <!-- Botón para retroceder -->

    <!-- Título de la página -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="51dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Retroceder"
        android:src="@drawable/retroceso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo de Pago Fácil -->

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="156dp"
        android:layout_height="42dp"
        android:layout_marginTop="48dp"
        android:text="Pago Fácil"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.393"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Instrucciones para el pago -->

    <ImageView
        android:id="@+id/logoPagoFacil"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Logo de Pago Fácil"
        android:src="@drawable/pagofacil"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <!-- Iconos e instrucciones -->
    <TextView
        android:id="@+id/txtInstrucciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="INSTRUCCIONES PARA PAGO"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoPagoFacil" />

    <LinearLayout
        android:id="@+id/layoutInstrucciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtInstrucciones">

        <!-- Primera instrucción -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconSucursal"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Sucursal"
                android:src="@drawable/banco" />

            <TextView
                android:id="@+id/txtSucursal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Acércate a una Sucursal de Pago Fácil"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Segunda instrucción -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconCuil"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="CUIL"
                android:src="@drawable/credencial" />

            <TextView
                android:id="@+id/txtCuil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Menciona el CUIL del titular de la cuenta"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Tercera instrucción -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconDinero"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Dinero"
                android:src="@drawable/efectivo" />

            <TextView
                android:id="@+id/txtDinero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Informa el importe que deseas abonar y listo"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

