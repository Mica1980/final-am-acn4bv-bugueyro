<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Incluir todos los datos compartidos -->
        <include domain="sharedpref" path="."/>
        <!-- Excluir archivos sensibles -->
        <exclude domain="sharedpref" path="sensitive_data.xml"/>
    </cloud-backup>

    <device-transfer>
        <!-- Incluir preferencias para transferencia -->
        <include domain="sharedpref" path="user_settings.xml"/>
        <!-- Excluir datos sensibles durante transferencia -->
        <exclude domain="database" path="private_data"/>
    </device-transfer>
</data-extraction-rules>
